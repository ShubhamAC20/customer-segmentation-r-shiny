fname <- "analysis.Rmd"
cat("File exists? ", file.exists(fname), "\n\n")
raw <- readLines(fname, warn = FALSE, encoding = "UTF-8")
cat("=== first 60 lines ===\n")
cat(paste0(sprintf("%3d: ", seq_len(min(60, length(raw)))), raw[1:min(60,length(raw))], collapse="\n"), "\n\n")
# BOM check
first_bytes <- readBin(fname, what="raw", n=3)
has_bom <- length(first_bytes) >=3 && all(first_bytes[1:3] == as.raw(c(0xEF,0xBB,0xBF)))
cat("BOM present? ", has_bom, "\n")
# smart quotes check (typical Unicode smart quote codes)
smart_pattern <- "[\u2018\u2019\u201C\u201D\u2013\u2014]"
has_smart <- any(grepl(smart_pattern, raw, perl=TRUE))
cat("Smart/curly quotes or dashes present? ", has_smart, "\n")
# count lines that begin with triple-backticks
fence_count <- sum(grepl("^\\s*```", raw))
cat("Lines starting with ``` : ", fence_count, "\n")
fname <- "analysis.Rmd"
cat("File exists? ", file.exists(fname), "\n\n")
raw <- readLines(fname, warn = FALSE, encoding = "UTF-8")
cat("=== first 60 lines ===\n")
cat(paste0(sprintf("%3d: ", seq_len(min(60, length(raw)))), raw[1:min(60,length(raw))], collapse="\n"), "\n\n")
# BOM check
first_bytes <- readBin(fname, what="raw", n=3)
has_bom <- length(first_bytes) >=3 && all(first_bytes[1:3] == as.raw(c(0xEF,0xBB,0xBF)))
cat("BOM present? ", has_bom, "\n")
# smart quotes check (typical Unicode smart quote codes)
smart_pattern <- "[\u2018\u2019\u201C\u201D\u2013\u2014]"
has_smart <- any(grepl(smart_pattern, raw, perl=TRUE))
cat("Smart/curly quotes or dashes present? ", has_smart, "\n")
# count lines that begin with triple-backticks
fence_count <- sum(grepl("^\\s*```", raw))
cat("Lines starting with ``` : ", fence_count, "\n")
sum(grepl("^\\s*```", readLines("analysis.Rmd")))
# should print a number > 1 (many chunk fences)
rmarkdown::render("analysis.Rmd", output_file = "analysis.html", envir = new.env())
# or click Knit in RStudio
raw <- readLines("analysis.Rmd", warn = FALSE, encoding = "UTF-8")
sum(grepl("^\\s*```", raw))
